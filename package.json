    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0"
  }
}
